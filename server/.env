# Postgres connection string — from your local Postgres, Supabase, Neon, Railway, etc.
DATABASE_URL="postgresql://user:password@localhost:5432/playnearby?schema=public"

PORT=4000

# Comma-separated list of origins allowed to call this API (your Next.js app)
CLIENT_ORIGIN="http://localhost:3000"

# From your Clerk dashboard -> API Keys
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"

# From your Clerk dashboard -> Webhooks -> (the endpoint you create for /api/webhooks/clerk)
CLERK_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"
