datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Matches the SportKey union already used across the frontend
// (FavSport, Services, Heroes). Add new sports here as a one-line change.
enum Sport {
  football
  cricket
  badminton
  chess
  carrom
  swimming
  tennis
  table_tennis
}

enum GameStatus {
  open
  full
  cancelled
  completed
}

enum BookingStatus {
  pending
  confirmed
  cancelled
}

// Mirrors the authenticated person. Keyed by Clerk's userId (`clerkId`) —
// Clerk owns identity/auth entirely; this table only holds app-specific data
// (hearts/karma, hosted games, bookings) that Clerk has no concept of.
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  name      String
  avatarUrl String?
  hearts    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hostedGames GameSession[]     @relation("HostedGames")
  joinedGames GameParticipant[]
  bookings    Booking[]
  blogs       Blog[]
}

model Venue {
  id          String   @id @default(cuid())
  name        String
  address     String
  latitude    Float
  longitude   Float
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  featured    Boolean  @default(false)
  images      String[]
  sports      Sport[]
  createdAt   DateTime @default(now())

  games    GameSession[]
  bookings Booking[]

  // Speeds up ORDER BY rating / featured filtering on the venues list.
  @@index([rating])
}

model GameSession {
  id        String     @id @default(cuid())
  sport     Sport
  format    String // e.g. "Doubles · Regular", "7 A Side · Regular"
  level     String // e.g. "Beginner - Professional"
  stateTag  String? // e.g. "MH"
  startsAt  DateTime
  endsAt    DateTime
  capacity  Int        @default(10)
  status    GameStatus @default(open)
  createdAt DateTime   @default(now())

  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id])

  hostId String
  host   User   @relation("HostedGames", fields: [hostId], references: [id])

  participants GameParticipant[]

  @@index([status, startsAt])
}

// Join table between User and GameSession — a player can join many games,
// a game can have many players. The host is stored separately on
// GameSession.hostId (a host doesn't have to also be a "participant" row,
// though your UI can choose to display them as one via the API response).
model GameParticipant {
  id       String      @id @default(cuid())
  gameId   String
  game     GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId   String
  user     User        @relation(fields: [userId], references: [id])
  joinedAt DateTime    @default(now())

  @@unique([gameId, userId]) // can't join the same game twice
}

model Booking {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  venueId    String
  venue      Venue         @relation(fields: [venueId], references: [id])
  slotStart  DateTime
  slotEnd    DateTime
  status     BookingStatus @default(pending)
  priceCents Int
  createdAt  DateTime      @default(now())

  @@index([venueId, slotStart])
}

model Blog {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  category    String
  image       String
  readTimeMin Int      @default(3)
  publishedAt DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
}
